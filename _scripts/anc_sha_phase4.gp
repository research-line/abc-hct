triples = [[2,6436341,6436343],[121,48234375,48234496],[1,4374,4375],[1,2400,2401],[3,125,128],[625,2048,2673],[1,5831,5832],[1,512,513],[1,242,243],[5,1024,1029],[1,80,81],[13,243,256],[81,1250,1331],[1,6859,6860],[1,8,9],[1,288,289],[49,576,625],[169,343,512],[1,9800,9801],[32,49,81],[8,1323,1331],[1,1024,1025],[25,704,729],[1,1215,1216],[1,63,64],[32,343,375],[104,625,729],[1,15624,15625],[1,675,676],[100,243,343],[1,624,625],[1,4095,4096],[1,728,729],[5,507,512],[81,1600,1681],[1,48,49],[81,175,256],[343,625,968],[81,544,625],[7,243,250],[640,729,1369],[2,243,245],[4,121,125],[27,512,539],[243,1088,1331],[5,27,32],[1,224,225],[200,529,729],[256,1331,1587],[1,960,961],[1,575,576],[2,25,27],[9,16,25],[1,24,25],[1,360,361],[1,49,50],[1,127,128],[1,124,125],[1,31,32]];

print("idx,a,b,c,orient,N,m,rank,tama,tors,sha_an,q,h_F_logN");
for(i=1, #triples, t = triples[i]; a = t[1]; b = t[2]; c = t[3]; if(a>b, [a,b]=[b,a]); if(a+b!=c||gcd(a,b)!=1, next); n_abc = a*b*c; n=n_abc; rad=1; d=2; while(d*d<=n, if(n%d==0, rad=rad*d; while(n%d==0, n=n\d)); d=d+1); if(n>1, rad=rad*n); q=log(1.0*c)/log(1.0*rad); for(orient=1, 2, if(orient==1, E=ellinit([0, b-a, 0, -a*b, 0]); ostr="STD", E=ellinit([0, a-b, 0, -a*b, 0]); ostr="ANC"); Em=ellminimalmodel(E); glob=ellglobalred(Em); N=glob[1]; tama=glob[3]; m=ellmoddegree(Em); rk=ellrank(Em)[1]; tors=elltors(Em)[1]; Disc=abs(Em.disc); h_F=log(1.0*Disc)/12; h_F_r=h_F/log(1.0*N); if(rk==0, L1=ellL1(Em); periods=Em.omega; om=abs(real(periods[1])); sha_raw=L1*tors^2/(om*tama); sha_corr=round(sha_raw/2); if(sha_corr<1, sha_corr=round(sha_raw)), sha_corr=-1); print(i, ",", a, ",", b, ",", c, ",", ostr, ",", N, ",", m, ",", rk, ",", tama, ",", tors, ",", sha_corr, ",", precision(q,4), ",", precision(h_F_r,4))));
print("DONE");
quit();
