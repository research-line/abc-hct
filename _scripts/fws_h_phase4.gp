triples = [[2,6436341,6436343],[121,48234375,48234496],[1,4374,4375],[1,2400,2401],[3,125,128],[625,2048,2673],[1,5831,5832],[1,512,513],[1,242,243],[5,1024,1029],[1,80,81],[13,243,256],[81,1250,1331],[1,6859,6860],[1,8,9],[1,288,289],[49,576,625],[169,343,512],[1,9800,9801],[32,49,81],[8,1323,1331],[1,1024,1025],[25,704,729],[1,1215,1216],[1,63,64],[32,343,375],[104,625,729],[1,15624,15625],[1,675,676],[100,243,343],[1,624,625],[1,4095,4096],[1,728,729],[5,507,512],[81,1600,1681],[1,48,49],[81,175,256],[343,625,968],[81,544,625],[7,243,250],[640,729,1369],[2,243,245],[4,121,125],[27,512,539],[243,1088,1331],[5,27,32],[1,224,225],[200,529,729],[256,1331,1587],[1,960,961],[1,575,576],[2,25,27],[9,16,25],[1,24,25],[1,8191,8192],[1,360,361],[1,49,50],[1,2047,2048],[1,1023,1024],[1,511,512],[1,19682,19683],[1,3124,3125],[1,27,28],[1,255,256],[1,127,128],[1,124,125],[1,31,32],[49,2048,2097],[3,4096,4099],[1,15,16],[1,168,169],[1,2401,2402],[3,1024,1027],[1,99,100],[27,125,152],[1,7,8],[4,729,733],[1,440,441],[1,323,324],[1,26,27],[16,243,259],[4,243,247],[7,9,16],[1,143,144],[64,81,145],[121,2187,2308],[32,81,113],[16,81,97],[2,81,83],[27,32,59],[16,27,43],[1,35,36],[1,121,122],[1,169,170],[8,27,35],[3,32,35],[4,27,31],[25,32,57],[1,17,18],[49,81,130],[5,32,37],[7,32,39],[5,16,21],[1,1342176,1342177]];

print("idx,a,b,c,N,h_F,h_F_logN,q,m");
for(i=1, #triples, t = triples[i]; a = t[1]; b = t[2]; c = t[3]; if(a>b, [a,b]=[b,a]); if(a+b!=c||gcd(a,b)!=1, print(i, ",SKIP"); next); E = ellinit([0, b-a, 0, -a*b, 0]); Em = ellminimalmodel(E); N = ellglobalred(Em)[1]; Disc = abs(Em.disc); h_F = log(1.0*Disc)/12; log_N = log(1.0*N); h_F_ratio = h_F/log_N; m = -1; n_abc = a*b*c; n = n_abc; rad = 1; d = 2; while(d*d <= n, if(n%d == 0, rad = rad*d; while(n%d == 0, n = n\d)); d = d+1); if(n > 1, rad = rad*n); q = log(1.0*c)/log(1.0*rad); print(i, ",", a, ",", b, ",", c, ",", N, ",", precision(h_F, 5), ",", precision(h_F_ratio, 5), ",", precision(q, 5), ",", m));
print("DONE");
quit();
